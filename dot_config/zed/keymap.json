// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "alt-t": "task::Spawn",
      "ctrl-alt-t": "task::Rerun"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-h": "vim::FirstNonWhitespace",
      "ctrl-l": "vim::EndOfLine",

      "ctrl-j": "vim::SelectNext",
      "ctrl-k": "vim::SelectPrevious",

      "alt-h": "pane::ActivatePreviousItem",
      "alt-l": "pane::ActivateNextItem"
    }
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "space q": ["pane::CloseActiveItem", { "close_pinned": false }]
    }
  },

  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "space f": "editor::Format",
      "space k": "editor::Hover",
      "space r": "editor::Rename",
      "space w": "workspace::Save",
      "space s": "outline::Toggle",
      "space shift-s": "project_symbols::Toggle",

      "space h": "editor::SelectAllMatches",
      // "space y": "editor::Copy",
      // "space p": "editor::Paste",

      "space d h": "editor::GoToPreviousDiagnostic",
      "space d l": "editor::GoToDiagnostic",

      "space o f": "file_finder::Toggle",
      "space e": "file_finder::Toggle",
      "space o t": "diagnostics::Deploy",
      "space o r": "editor::FindAllReferences",
      "space o i": "editor::GoToImplementation",
      "space o a": "editor::ToggleCodeActions",

      "shift-y": ["workspace::SendKeystrokes", "y $"]
    }
  },
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
    "bindings": {
      "q": "vim::MiniQuotes",
      "b": "vim::MiniBrackets"
    }
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "y y": "vim::VisualYank",
      "shift-y": "vim::VisualYankLine",
      "y s": "vim::PushAddSurrounds"
    }
  }
]
