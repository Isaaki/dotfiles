// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "inlay_hints": {
    "enabled": false,
  },
  "diff_view_style": "split",
  "which_key": {
    "delay_ms": 500,
    "enabled": true,
  },
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "dock": "right",
  },
  "agent": {
    "terminal_init_command": "claude",
    "show_turn_stats": false,
    "message_editor_min_lines": 4,
    "thinking_display": "always_expanded",
    "single_file_review": true,
    "play_sound_when_agent_done": "always",
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-flash",
      "enable_thinking": true,
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "right",
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "default",
        "mode": "auto",
      },
      "type": "registry",
    },
  },
  "tab_size": 2,
  "vertical_scroll_margin": 14.0,
  "redact_private_values": false,
  "outline_panel": {
    "dock": "right",
    "indent_guides": {
      "show": "always",
    },
  },
  "window_decorations": "client",
  "tabs": {
    "show_close_button": "hidden",
    "file_icons": false,
    "git_status": false,
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": false,
    "show": true,
  },
  "title_bar": {
    "show_menus": false,
  },
  "search": {
    "center_on_match": true,
  },
  "project_panel": {
    "dock": "right",
    "default_width": 200.0,
    "hide_hidden": false,
    "hide_root": false,
    "scrollbar": {
      "show": "auto",
    },
    "indent_size": 14.0,
    "entry_spacing": "standard",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "indent_aware",
  },
  "autoscroll_on_clicks": false,
  "colorize_brackets": true,
  "format_on_save": "off",
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "buffer_font_weight": 500,

  "buffer_font_family": "ComicCode Nerd Font",
  "buffer_font_fallbacks": [
    ".ZedMono",
    "Consolas",
    "Inconsolata",
    "Ubuntu Mono",
  ],
  "preview_tabs": {
    "enabled": true,
  },
  "theme": {
    "mode": "light",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
  "theme_overrides": {
    "Ayu Light": {
      "editor.foreground": "#33383d",
      "syntax": {
        "variable": { "color": "#33383d" },
        "punctuation": { "color": "#5a5f65" },
        "keyword":  { "color": "#e8700f" },
        "function": { "color": "#d98a00" },
        "string":   { "color": "#6c9a00" },
        "number":   { "color": "#8e52cc" },
        "boolean":  { "color": "#8e52cc" },
        "constant": { "color": "#8e52cc" },
        "type":     { "color": "#1f88d6" },
        "property": { "color": "#2a8bd0" },
        "tag":      { "color": "#2aa0c4" },
        "operator": { "color": "#e07a3a" },
        "comment":  { "color": "#959aa0", "font_style": "italic" }
      }
    }
  },
  "dap": {
    "CodeLLDB": {
      "binary": "/usr/bin/codelldb",
    },
    "netcoredbg": {
      "binary": "~/.local/bin/netcoredbg",
    },
  },
  "languages": {
    "TypeScript": {
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.addMissingImports": true,
      },
      "language_servers": ["vtsls", "!typescript-language-server", "..."],
    },
    "Zig": {
      "inlay_hints": {
        "enabled": true,
      },
      "code_actions_on_format": {
        "source.fixAll": true,
        "source.organizeImports": true,
      },
      "tab_size": 4,
    },
    "Vue.js": {
      "language_servers": [
        "vue-language-server",
        "vtsls",
        "!typescript-language-server",
        "...",
      ],
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.addMissingImports": true,
      },
    },
    "CSharp": {
      "inlay_hints": {
        "enabled": true,
      },
      "tab_size": 4,
    },
    "TSX": {
      "language_servers": ["vtsls", "!typescript-language-server", "..."],
    },
    "JavaScript": {
      "language_servers": ["vtsls", "!typescript-language-server", "..."],
    },
  },

  "load_direnv": "shell_hook",

  "terminal": {
    "env": {
      "DIRENV_LOG_FORMAT": "",
    },
  },

  "lsp": {
    "vue-language-server": {
      "initialization_options": {
        "typescript": {
          "tsdk": "./node_modules/typescript/lib",
        },
      },
    },
    "zls": {
      "settings": {
        "path_lookup": true,
      },
      "initialization_options": {
        "enable_build_on_save": true,
        "build_on_save_step": "check",
      },
    },
  },

  "context_servers": {
    "linear": {
      "url": "https://mcp.linear.app/mcp",
    },
  },

  "auto_install_extensions": {
    "vue": true,
    "html": true,
    "toml": true,
    "csharp": true,
    "material-icon-theme": true,
    "xml": true,
    "zig": true,
    "nix": true,
    "kdl": true,
    "markdown-oxide": true,
  },

  // VIM
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "extend_comment_on_newline": false,
}
